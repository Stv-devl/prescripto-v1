# Environment: local | staging | production
# "local" is the ONLY value that enables the dev shortcuts (unauthenticated
# requests served as the seeded dev user, dev tenant/user creation at startup).
# Default when unset: production. Never set this to "local" on a server.
ENVIRONMENT=local

# ── Required — the API refuses to start without these ────────────────

# Database
DATABASE_URL=postgresql+asyncpg://prescripto:prescripto_dev_local@localhost:5432/prescripto

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key

# JWT — 32 characters minimum, and not a placeholder: openssl rand -hex 32
JWT_SECRET_KEY=your_JWT_key

# ── Optional — defaults live in app/core/config.py ───────────────────

# Qdrant
QDRANT_URL=http://localhost:6333

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@prescripto.fr
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@prescripto.fr

# App
APP_URL=https://prescripto.fr
API_URL=https://api.prescripto.fr
CORS_ORIGINS=["https://prescripto.fr"]

# ── Operator access ──────────────────────────────────────────────────

# The addresses that hold role="admin", reconciled at every startup: listed is
# promoted, removed is demoted. Comma or semicolon separated, empty is legal.
# Matching is exact, and signup refuses a listed address — so register the
# account FIRST, then list it. Blank on a deployed instance means nobody
# reaches /api/admin/*, which is the safe default.
ADMIN_EMAILS=

# ── Behind a reverse proxy ───────────────────────────────────────────

# REQUIRED on staging and production: the API refuses to start without it.
# uvicorn only believes X-Forwarded-For from the addresses listed here, and its
# own default (127.0.0.1) is never a proxy that reaches the container over a
# Docker or VPC network — so every visitor would resolve to the proxy's address,
# share one rate-limit counter, and the first burst would lock all of them out.
# Put the subnet the proxy reaches this container from, e.g. 172.18.0.0/16 for a
# Docker bridge, or the VPC CIDR on AWS.
# NEVER "*" nor 0.0.0.0/0: uvicorn then trusts the header from anyone, so the
# caller picks their own rate-limit key — and can pin it on someone else.
FORWARDED_ALLOW_IPS=

# ── Rate limiting (optional, defaults in app/core/config.py) ─────────

RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_RESET_PER_WINDOW=10
RATE_LIMIT_RESET_WINDOW_SECONDS=900